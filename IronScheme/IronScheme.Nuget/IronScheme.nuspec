<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
  <metadata>
    <id>IronScheme</id>
    <version>$version$</version>
    <authors>Llewellyn Pritchard</authors>
    <owners>Llewellyn Pritchard</owners>
    <iconUrl>http://ironscheme.net/logo-192.png</iconUrl>
    <projectUrl>https://github.com/IronScheme</projectUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>IronScheme.dll and libs</description>
    <releaseNotes>https://github.com/IronScheme</releaseNotes>
    <copyright>Copyright 2007-2021</copyright>
    <tags>scheme ironscheme r6rs</tags>
    <repository type="git" url="https://github.com/IronScheme/IronScheme" branch="master" commit="$sha$" />
    <dependencies>
      <dependency id="IronScheme.Core" version="$version$" />
    </dependencies>
  </metadata>

  <files>
    <file src="IronScheme\system-libraries*.ss" target="content\" />
    <file src="IronScheme\lib\**" target="content\lib\" exclude="**\web*.*;**web**;**\xml.sls"/>
  </files>
</package>